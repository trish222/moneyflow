# Server configuration
PORT=3000
NODE_ENV=development

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/moneyflow_dev"

# JWT Secrets (required; generate with: openssl rand -base64 32)
# Must be at least 32 characters
JWT_SECRET="your-jwt-secret-here-at-least-32-chars"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-here-at-least-32-chars"

# Frontend URL (required; CORS origin)
# In development: http://localhost:5173 (Vite dev server)
# In production: https://app.example.com
FRONTEND_URL="http://localhost:5173"

# Registration control: only allow when explicitly set to 'true'
# Default: false (registration disabled)
# Set to 'true' only in development for testing
ALLOW_REGISTRATION=false
